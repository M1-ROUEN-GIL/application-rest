# ==============================================================================
# Configuration d'environnement pour SEPA26
# ==============================================================================

# Port d'écoute du serveur Spring Boot
SERVER_PORT=8100

# Paramètres de la base de données MariaDB
DB_URL=jdbc:mariadb://db:3306/sepa26_db
DB_USER=sepa_user
DB_PASSWORD=sepa_password
DB_ROOT_PASSWORD=root_password
