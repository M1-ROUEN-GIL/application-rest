<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://univ.fr/sepa26"
           xmlns="http://univ.fr/sepa26"
           elementFormDefault="qualified">

    <xs:simpleType name="Max35Text">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="35"/>
            <xs:pattern value="([a-zA-Z0-9\-?:().,'+ ]+(/[a-zA-Z0-9\-?:().,'+ ]+)*)"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Max140Text">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="140"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Max15NumericText">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{1,15}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="DecimalNumber">
        <xs:restriction base="xs:decimal">
            <xs:fractionDigits value="2"/>
            <xs:totalDigits value="18"/>
            <xs:pattern value="[0-9]{1,15}(\.[0-9]{1,2})?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IBANType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{2}[0-9]{2}[A-Z0-9]{1,30}"/>
            <xs:minLength value="15"/>
            <xs:maxLength value="34"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="BICType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SeqTpType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="OOFF"/>
            <xs:enumeration value="RCUR"/>
            <xs:enumeration value="FRST"/>
            <xs:enumeration value="FNAL"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="CmpsdNmd">
        <xs:sequence>
            <xs:element name="Nm" type="Max35Text"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CmpsdIdt">
        <xs:sequence>
            <xs:element name="Id">
                <xs:complexType>
                    <xs:choice>
                        <xs:element name="IBAN" type="IBANType"/>
                        <xs:element name="PrvtId">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="Othr">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="Id" type="Max35Text"/>
                                                <xs:element name="SchmeNm">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="Prtry" type="Max35Text"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:choice>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CmpsdAgt">
        <xs:sequence>
            <xs:element name="FinInstnId">
                <xs:complexType>
                    <xs:choice>
                        <xs:element name="BIC" type="BICType"/>
                        <xs:element name="Othr">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="Id" type="Max35Text"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:choice>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CmpsdTpInf">
        <xs:sequence>
            <xs:element name="SvcLvl" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Cd" type="Max35Text"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="LclInstrm" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Cd" type="Max35Text"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="SeqTp" type="SeqTpType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CmpsdTx">
        <xs:sequence>
            <xs:element name="MndtRltdInf">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="MndtId"    type="Max35Text"/>
                        <xs:element name="DtOfSgntr" type="xs:date"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CmpsdSchmeId">
        <xs:sequence>
            <xs:element name="Id">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="PrvtId">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="Othr">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="Id" type="Max35Text"/>
                                                <xs:element name="SchmeNm">
                                                    <xs:complexType>
                                                        <xs:sequence>
                                                            <xs:element name="Prtry" type="Max35Text"/>
                                                        </xs:sequence>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DrctDbtTxInfType">
        <xs:sequence>
            <!-- 1.2.10.1 Payment Identification -->
            <xs:element name="PmtId"    type="Max35Text"/>
            <!-- 1.2.10.2 Instructed Amount §3.6.6 -->
            <xs:element name="InstdAmt">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="DecimalNumber">
                            <xs:attribute name="Ccy" use="required">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="[A-Z]{3}"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
            <xs:element name="DrctDbtTx" type="CmpsdTx"/>
            <xs:element name="DbtrAgt" type="CmpsdAgt"/>
            <xs:element name="Dbtr" type="CmpsdNmd"/>
            <xs:element name="DbtrAcct" type="CmpsdIdt"/>
            <xs:element name="RmtInf" type="Max140Text" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PmtInfType">
        <xs:sequence>
            <xs:element name="PmtInfId" type="Max35Text"/>
            <xs:element name="NbOfTxs" type="Max15NumericText" minOccurs="0"/>
            <xs:element name="CtrlSum" type="DecimalNumber" minOccurs="0"/>
            <xs:element name="PmtTpInf" type="CmpsdTpInf" minOccurs="0"/>
            <xs:element name="ReqdColltnDt" type="xs:date"/>
            <xs:element name="Cdtr" type="CmpsdNmd"/>
            <xs:element name="CdtrAcct" type="CmpsdIdt"/>
            <xs:element name="CdtrAgt" type="CmpsdAgt"/>
            <xs:element name="CdtrSchmeId" type="CmpsdSchmeId" minOccurs="0"/>

            <xs:element name="DrctDbtTxInf" type="DrctDbtTxInfType" minOccurs="1" maxOccurs="10"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="GrpHdrType">
        <xs:sequence>
            <xs:element name="MsgId" type="Max35Text"/>
            <xs:element name="CreDtTm" type="xs:dateTime"/>
            <xs:element name="NbOfTxs" type="Max15NumericText"/>
            <xs:element name="CtrlSum" type="DecimalNumber"/>
            <xs:element name="InitgPty" type="CmpsdNmd"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="Document">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="CstmrDrctDbtInitn">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="GrpHdr" type="GrpHdrType"/>
                            <xs:element name="PmtInf" type="PmtInfType" minOccurs="1" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>